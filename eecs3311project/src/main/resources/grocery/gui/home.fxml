<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="grocery.gui.HomeController"
            fitToWidth="true"
            styleClass="page-scroll">

    <content>
        <VBox spacing="25" styleClass="page-content">

            <Label text="What are you shopping for?"
                   styleClass="section-title"/>

            <VBox spacing="18" styleClass="request-card">

                <Label text="Shopping Request"
                       styleClass="field-label"/>

                <TextArea fx:id="requestField"
                          promptText="E.g. I need milk, bread and eggs for breakfast"
                          prefRowCount="5"
                          wrapText="true"
                          styleClass="request-input"/>

                <HBox spacing="20"
                      alignment="BOTTOM_LEFT">

                    <VBox spacing="8">
                        <Label text="Budget ($)"
                               styleClass="field-label"/>

                        <TextField fx:id="budgetField"
                                   promptText="40.00"
                                   prefWidth="180"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="generateButton"
                            text="Generate Plan"
                            onAction="#generatePlan"
                            styleClass="primary-button"/>

                </HBox>

                <ProgressIndicator fx:id="loadingIndicator"
                                   visible="false"
                                   managed="false"
                                   prefWidth="35"
                                   prefHeight="35"/>

                <Label fx:id="statusLabel"
                       text=""
                       wrapText="true"
                       styleClass="muted-label"/>

            </VBox>
        </VBox>
    </content>

</ScrollPane>
