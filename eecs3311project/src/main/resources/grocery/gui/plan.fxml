<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="grocery.gui.PlanController"
            fitToWidth="true"
            styleClass="page-scroll">

    <content>
        <VBox spacing="20" styleClass="page-content">

            <Label fx:id="planNameLabel"
                   text="Shopping Plan"
                   styleClass="section-title"/>

            <Label fx:id="totalLabel"
                   text="\$0.00"
                   styleClass="total-label"/>

            <Label fx:id="budgetLabel"
                   text="No shopping plan generated."
                   styleClass="muted-label"/>

            <ProgressBar fx:id="budgetProgress"
                         progress="0"
                         prefHeight="18"
                         minHeight="18"
                         maxHeight="18"
                         minWidth="0"
                         maxWidth="Infinity"
                         styleClass="budget-progress"
                         style="-fx-accent: #C44900;"/>

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="percentLabel"
                       text="0% of budget"
                       styleClass="muted-label"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="remainingLabel"
                       text="\$0.00 remaining"
                       styleClass="muted-label"/>
            </HBox>

            <TableView fx:id="itemsTable"
                    prefHeight="330"
                    maxWidth="Infinity"
                    styleClass="shopping-table">

                <columns>
                    <TableColumn fx:id="itemColumn"
                                text="Item"
                                resizable="true"
                                sortable="false"
                                prefWidth="180"/>

                    <TableColumn fx:id="quantityColumn"
                                text="Qty"
                                resizable="true"
                                sortable="false"
                                prefWidth="70"/>

                    <TableColumn fx:id="productColumn"
                                text="Product"
                                resizable="true"
                                sortable="false"
                                prefWidth="280"/>

                    <TableColumn fx:id="storeColumn"
                                text="Store"
                                resizable="true"
                                sortable="false"
                                prefWidth="150"/>

                    <TableColumn fx:id="saleColumn"
                                text="Sale?"
                                resizable="true"
                                sortable="false"
                                prefWidth="100"/>

                    <TableColumn fx:id="priceColumn"
                                text="Price" resizable="true"
                                sortable="false" prefWidth="120"/>
                    <TableColumn fx:id="sourceColumn"
                                text="Source" prefWidth="110"/>
                </columns>

            </TableView>



            <!-- All three actions stay on one horizontal row. -->
            <HBox spacing="14" alignment="CENTER_LEFT" maxWidth="Infinity">
                <Button fx:id="alternativeButton"
                        text="Find Alternative"
                        onAction="#findAlternative"
                        disable="true"
                        styleClass="primary-button"/>
                <Button fx:id="removeProductButton"
                        text="Remove Product"
                        onAction="#removeSelectedProduct"
                        styleClass="primary-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="refreshPlanButton"
                        text="Refresh Plan"
                        onAction="#refreshPlan"
                        styleClass="primary-button"/>
            </HBox>

            <!-- Optimization Options -->
            
            <Label text="Optimization"
                styleClass="section-title"/>

            <HBox spacing="15" fillHeight="true">

                <Button fx:id="cheapestButton"
                        text="Cheapest"
                        onAction="#optimizeCheapest"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        styleClass="optimization-button"/>
                        

                <Button fx:id="fewestStoresButton"
                        text="Fewest Stores"
                        onAction="#optimizeFewestStores"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        styleClass="optimization-button"/>

                <Button fx:id="oneStoreButton"
                        text="One Store"
                        onAction="#optimizeOneStore"
                        maxWidth="Infinity"
                        HBox.hgrow="ALWAYS"
                        styleClass="optimization-button"/>

            </HBox>

            <Label fx:id="optimizationStatusLabel"
                text="Generate a shopping plan to start optimizing."
                wrapText="true"
                styleClass="muted-label"/>


        </VBox>
    </content>
</ScrollPane>
